{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.13"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "cosmos-chrome"
          },
          "size": {
            "px": 128
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "cosmos-spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "cosmos-agents"
              },
              "size": {
                "weight": 1.5
              },
              "min": 90
            },
            {
              "id": "tree",
              "type": "block",
              "content": {
                "mod": "cosmos-tree"
              },
              "size": {
                "weight": 1
              },
              "min": 90,
              "hidden": true
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "cosmos-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 86
          }
        }
      ],
      "size": {
        "px": 288
      },
      "min": 44,
      "max": 480,
      "background": {
        "image": "mods/cosmos-chrome/nebula-sidebar-dim.png",
        "fit": "cover"
      },
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "cosmos-tabs"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": {
                    "image": "mods/cosmos-chrome/nebula-stage.png",
                    "fit": "cover"
                  },
                  "border": {
                    "width": 1,
                    "color": "#7ee0ff26"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 12,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "cosmos-status"
          },
          "size": {
            "px": 26
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "theme": "cosmos",
  "terminal_opacity": 0.8,
  "font": "JetBrains Mono",
  "ui_font": "Geist",
  "preview": "layouts/cosmos.png"
}
